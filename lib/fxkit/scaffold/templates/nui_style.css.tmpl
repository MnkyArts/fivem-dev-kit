* {
    box-sizing: border-box;
}

html, body {
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    background: transparent;
    font-family: -apple-system, "Segoe UI", Roboto, sans-serif;
    color: #f2f2f2;
}

body.hidden {
    display: none;
}

#app {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    min-width: 260px;
    padding: 24px;
    border-radius: 8px;
    background: rgba(20, 20, 20, 0.85);
}

#close-btn {
    margin-top: 12px;
    padding: 6px 14px;
    border: none;
    border-radius: 4px;
    background: #3a3a3a;
    color: #f2f2f2;
    cursor: pointer;
}

#close-btn:hover {
    background: #4a4a4a;
}
