// {{name}} :: server

function debugPrint(...args) {
    if (Config.Debug) {
        console.log(...args);
    }
}

on('onResourceStart', (resourceName) => {
    if (GetCurrentResourceName() !== resourceName) {
        return;
    }

    debugPrint(`^2[{{name}}]^7 started`);
});

on('onResourceStop', (resourceName) => {
    if (GetCurrentResourceName() !== resourceName) {
        return;
    }

    debugPrint(`^2[{{name}}]^7 stopped`);
});

