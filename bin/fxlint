#!/usr/bin/env python3
"""fxlint -- heuristic Lua/JS/TS linter for FiveM resources.

Usage:
  fxlint <resource_dir|file...> [--json] [--no-verify] [--strict] [--rules R1,R2] [--ignore R1,R2]

See $KIT/docs/fxlint.md for the full rule catalogue.
"""
from __future__ import annotations

import argparse
import json
import os
import sys
from pathlib import Path

_KIT_ROOT = Path(os.path.realpath(__file__)).resolve().parent.parent
_LIB = _KIT_ROOT / "lib"
if str(_LIB) not in sys.path:
    sys.path.insert(0, str(_LIB))

from fxkit.lint import engine, report  # noqa: E402


def _split_rules(value: str) -> set:
    return {r.strip().upper() for r in value.split(",") if r.strip()}


def _load_fxlintrc(targets) -> dict:
    """Auto-apply <resource_dir>/.fxlintrc.json's "ignore"/"rules" lists as
    defaults (an explicit --rules/--ignore on the command line always wins).
    Only kicks in for the common `fxlint <one-resource-dir>` invocation --
    with multiple/loose-file targets there's no single resource to read a
    config from, so this is silently skipped."""
    if len(targets) != 1:
        return {}
    p = Path(targets[0])
    if not p.is_dir():
        return {}
    rc = p / ".fxlintrc.json"
    if not rc.exists():
        return {}
    try:
        data = json.loads(rc.read_text(encoding="utf-8"))
    except (ValueError, OSError):
        return {}
    return data if isinstance(data, dict) else {}


def main(argv=None) -> int:
    parser = argparse.ArgumentParser(prog="fxlint", description="Heuristic Lua/JS/TS linter for FiveM resources.")
    parser.add_argument("targets", nargs="+", help="a resource directory, or one or more Lua/JS/TS files")
    parser.add_argument("--json", action="store_true", help="emit a machine-readable JSON report instead of text")
    parser.add_argument("--no-verify", action="store_true", help="skip native database verification (C007/C008)")
    parser.add_argument("--strict", action="store_true", help="treat warnings as errors for the exit code")
    parser.add_argument("--rules", metavar="R1,R2", help="only run these rule ids")
    parser.add_argument("--ignore", metavar="R1,R2", help="skip these rule ids")
    args = parser.parse_args(argv)

    missing = [t for t in args.targets if not Path(t).exists()]
    if missing:
        for m in missing:
            print(f"fxlint: no such file or directory: {m}", file=sys.stderr)
        return 2

    findings, notes = engine.lint(args.targets, no_verify=args.no_verify)

    rc = _load_fxlintrc(args.targets)
    rules_value = args.rules or (",".join(rc.get("rules") or []) or None)
    ignore_value = args.ignore or (",".join(rc.get("ignore") or []) or None)

    if rules_value:
        wanted = _split_rules(rules_value)
        findings = [f for f in findings if f.rule in wanted]
    if ignore_value:
        ignored = _split_rules(ignore_value)
        findings = [f for f in findings if f.rule not in ignored]

    findings = report.apply_strict(findings, args.strict)

    if args.json:
        print(report.format_json(findings, notes))
    else:
        print(report.format_text(findings, notes))

    return report.exit_code(findings)


if __name__ == "__main__":
    sys.exit(main())
